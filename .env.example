# Database
DATABASE_URL="postgresql://pixel:pixel123@localhost:5434/pixel"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# Super admin (created by the seed on first run)
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Domain used for internal user emails (users sign up with a username only)
USER_EMAIL_DOMAIN="pixel.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Optional: contact email shown in settings for custom domain requests
NEXT_PUBLIC_CONTACT_EMAIL=""

# Traefik dynamic config (for custom domain support)
# Shared volume path that Traefik watches for dynamic configs
TRAEFIK_DYNAMIC_DIR=""
# Internal app URL from Traefik's perspective (e.g. http://pixel_app_prod:3000)
TRAEFIK_SERVICE_URL="http://localhost:3000"
# Let's Encrypt cert resolver name configured in Traefik
TRAEFIK_CERT_RESOLVER="letsencrypt"

# Server IP shown to users for A-record DNS setup
NEXT_PUBLIC_SERVER_IP=""
